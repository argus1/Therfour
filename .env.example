# Application
APP_NAME=Therfour
DEBUG=false

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public hostname used to build the WebSocket URL returned in TwiML.
# When running locally use an ngrok tunnel and set this to the ngrok hostname.
PUBLIC_HOST=your-ngrok-or-domain.com

# STT – faster-whisper
# Model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=en   # Uncomment to pin a language; leave unset for auto-detect
WHISPER_FALLBACK_ENABLED=true
WHISPER_PRIMARY_BEAM_SIZE=5
WHISPER_FALLBACK_BEAM_SIZE=1
STT_MIN_TEXT_CHARACTERS=2
STT_MIN_QUALITY_SCORE=0.25

# VAD – Silero
VAD_ENABLED=true
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=300
VAD_SPEECH_PAD_MS=96
VAD_PREROLL_MS=96

# TTS – Piper (https://github.com/rhasspy/piper)
# Path to the compiled piper binary (must be on $PATH or provide absolute path)
PIPER_BINARY=piper
# Path to the .onnx voice model file.
# This repo now supports tracked Google Drive stub manifests under models/stubs/
# and Git LFS for large local artifacts under models/.
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx

# LLM – Ollama (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30.0


# Audio pipeline
SILENCE_TIMEOUT_S=1.5
MIN_AUDIO_DURATION_S=0.3
