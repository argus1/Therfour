# Application
APP_NAME=Therfour
DEBUG=false

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public hostname used to build the WebSocket URL returned in TwiML.
# When running locally use an ngrok tunnel and set this to the ngrok hostname.
PUBLIC_HOST=your-ngrok-or-domain.com

# STT – faster-whisper
# Model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=en   # Uncomment to pin a language; leave unset for auto-detect
WHISPER_FALLBACK_ENABLED=true
WHISPER_PRIMARY_BEAM_SIZE=5
WHISPER_FALLBACK_BEAM_SIZE=1
STT_MIN_TEXT_CHARACTERS=2
STT_MIN_QUALITY_SCORE=0.25
# Primary STT backend: whisper or sherpa
STT_PRIMARY_BACKEND=whisper
# Use Sherpa-ONNX when Whisper returns no_speech/low_quality
STT_SHERPA_FALLBACK_ENABLED=true
# Directory containing encoder.int8.onnx and decoder.int8.onnx
SHERPA_MODEL_DIR=models/sherpa
# Path to Sherpa tokens.txt
SHERPA_TOKENS_PATH=models/sherpa/tokens.txt
SHERPA_NUM_THREADS=1

# VAD – Silero
VAD_ENABLED=true
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=300
VAD_SPEECH_PAD_MS=96
VAD_PREROLL_MS=96

# TTS – Piper (https://github.com/rhasspy/piper)
# Path to the compiled piper binary (must be on $PATH or provide absolute path)
PIPER_BINARY=piper
# Path to the .onnx voice model file.
# This repo now supports tracked Google Drive stub manifests under models/stubs/
# and Git LFS for large local artifacts under models/.
PIPER_MODEL_PATH=models/piper/en_US-libritts_r-medium.onnx
# Piper voice id used when voice is omitted or unsupported.
PIPER_DEFAULT_VOICE_ID=en-US-libritts-r-medium
# JSON mapping voice ids/aliases to Piper model paths.
PIPER_VOICES_CONFIG_PATH=app/core/piper_voices.json

# LLM – Ollama (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
# Name Ollama knows the model by (must match the name used in bootstrap_ollama.py).
OLLAMA_MODEL=qwen3.5-35b-a3b:q2-k-xl
OLLAMA_TIMEOUT=60.0
# Path to the GGUF file Ollama will register on first boot.
# Hydrate from stub first: python scripts/fetch_stub.py models/stubs/llm/Qwen3.5-35B-A3B-UD-Q2_K_XL.gguf.stub.json
OLLAMA_MODEL_GGUF_PATH=models/llm/Qwen3.5-35B-A3B-UD-Q2_K_XL.gguf
# Seconds to wait for Ollama to become reachable on startup.
OLLAMA_READY_TIMEOUT=120.0


# Audio pipeline
SILENCE_TIMEOUT_S=1.5
MIN_AUDIO_DURATION_S=0.3
